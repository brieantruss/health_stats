[Unit]
Description=Prefect Agents Daemon for Health Stats
After=network.target mysql.service prefect-server.service prefect-daemon.service

[Service]
Type=simple
User=briean
WorkingDirectory=/home/briean/health_stats
ExecStartPre=+/usr/bin/install -d -o briean -g briean /tmp/runner_storage
ExecStart=/usr/bin/python3 scripts/agents/orchestrate_agents.py --deploy
Restart=always
RestartSec=10
Environment=PREFECT_API_URL=http://localhost:4200/api

[Install]
WantedBy=multi-user.target
